# ---- Core infra ----
NODE_ENV=development
# Postgres. Local dev: infra/docker-compose.yml. Production: Supabase (Project Settings → Database).
#   App / serverless: use the Supabase **Transaction pooler** URL (port 6543) — the client
#     auto-disables prepared statements when it detects a pooler.
#   Migrations (pnpm db:migrate): set DIRECT_DATABASE_URL to the **direct** connection (port 5432).
#   Enable extensions once in Supabase: `vector` and `pg_trgm` (the migrate step also CREATE EXTENSIONs).
#
#   ROW-LEVEL SECURITY (PLAN §11): for RLS to actually enforce isolation, DATABASE_URL must connect
#   as a RESTRICTED, non-owner login role that is a member of `grocery_app` (migrate.ts creates that
#   role + the policies). If DATABASE_URL uses the owner/superuser (`postgres`), RLS is BYPASSED —
#   i.e. security theater. DIRECT_DATABASE_URL stays the owner (it runs migrations + provisioning).
#   Local setup once:  CREATE ROLE app_user LOGIN PASSWORD '<pw>' IN ROLE grocery_app;
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/grocery_manager
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grocery_manager
# DATABASE_URL=postgres://app_user.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_DATABASE_URL=postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# ---- LLM (Google Gemini via @google/genai) ----
# Dev: a Gemini Developer API key (AI Studio). Prod: prefer Vertex AI (no-training + enterprise controls).
GEMINI_API_KEY=
# Set these to route through Vertex AI instead of the Developer API:
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# Flash-Lite is public preview; flip to false to fall back to gemini-2.5-flash everywhere.
LLM_USE_FLASH_LITE=true

# ---- Auth (Google OAuth — also used for Gmail read-only) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Envelope-encryption key id (KMS) used to wrap per-record data keys for OAuth tokens / cookies.
KMS_KEY_ID=

# ---- Integrations ----
INSTACART_API_KEY=
SPOONACULAR_API_KEY=
AMAZON_ASSOCIATE_TAG=

# ---- Object storage (S3-compatible: R2 / Supabase Storage) ----
S3_ENDPOINT=
S3_BUCKET=grocery-manager
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
